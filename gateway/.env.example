PORT=8787
BIND_HOST=127.0.0.1
NODE_ENV=development
PANEL_ALLOWED_ORIGIN=http://localhost:8000
GATEWAY_MODE=mock
# Manter unconfigured ate a TI implementar e aprovar o provider corporativo.
AUTH_MODE=unconfigured
# Em producao, somente depois da entrega da TI: AUTH_MODE=corporate
MOCK_SCENARIO=normal
# YMS_MODE=disabled preserva o snapshot atual. Use mock apenas em desenvolvimento.
# Em runtime autorizado, use YMS_MODE=provider.
# O provider real usa ADC/identidade de workload; nao grave chave, token ou credencial neste arquivo.
YMS_MODE=disabled
# Identificadores nao secretos do BigQuery. Ajustar somente se a infraestrutura exigir.
GOOGLE_CLOUD_PROJECT=
BIGQUERY_LOCATION=
DISPATCH_BASE_URL=https://envios.adminml.com
CUSTOMS_BASE_URL=https://envios.adminml.com
DISPATCH_PATH=/logistics/last-mile/monitoring/frm-provider/api/dispatch
CUSTOMS_PATH=/logistics/audit/api/audits/search
ALLOWED_FACILITY_IDS=SSP15
ALLOWED_SITE_IDS=MLB
# Em production, definir explicitamente o(s) groupId(s) autorizado(s) pela TI.
ALLOWED_GROUP_IDS=TESTE
ALLOWED_CYCLES=AM1
ALLOWED_WAVES=1,2,3,4,5
UPSTREAM_TIMEOUT_MS=1000
MAX_RESPONSE_BYTES=262144
